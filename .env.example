# SARVAM_API_KEY: Required for Sarvam AI Voice & Multilingual NLU API calls.
SARVAM_API_KEY="MY_SARVAM_API_KEY"

# MONGODB_URI: Connection string for hospital persistence (optional, falls back to in-memory store)
MONGODB_URI="mongodb://localhost:27017/careflow"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

